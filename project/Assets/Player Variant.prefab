--- !u!114 &7150062248099750355
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4572722567676010423}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce7677113a2713845a773a97253e8f08, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  headingText: {fileID: 0}
  dialogueText: {fileID: 0}
  dialoguePanel: {fileID: 0}
  dialogues:
  - speakerName: Ranger
    lines:
    - "Come on, come on\u2026No signal! This storm is cutting off everything!"
  - speakerName: Randy
    lines:
    - "Hey\u2026 hey, it's Randy! I\u2019m stuck, man! Fell down a hole, no idea
      where I am. I saw a radio tower before I fell\u2014took a shortcut off the
      main path."
  - speakerName: Ranger
    lines:
    - "Hang tight, Randy! I\u2019m coming for you. Just keep calm and don\u2019t
      do anything stupid."
  - speakerName: Ranger
    lines:
    - I swear, Randy, you owe me big time for this.
  - speakerName: Randy
    lines:
    - "It\u2019s filling up with water, man\u2026 I don\u2019t know how much longer
      I can hold on!"
  - speakerName: Ranger
    lines:
    - "Found it! I see the path you took. Hold on, Randy, I\u2019m almost there."
  triggerDialogue: 0
